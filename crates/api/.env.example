# app
LISTEN_ADDR=0.0.0.0:8000
SESSION_DURATION_MINUTES=30
FRONTEND_URL="http://localhost:3000"

# rust
RUST_LOG=debug

# secrets
DATABASE_URL=postgresql://postgres:secret@localhost:5432/postgres
# Managed databases: use the DIRECT endpoint and verify the certificate. The
# bundled webpki roots (sqlx `tls-rustls-ring`) trust the usual public CAs, so
# no extra setup is needed.
#   DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=verify-full
# A POOLED endpoint typically runs in transaction mode and cannot keep prepared
# statements alive across transactions -- behind one you must also set
# DATABASE_STATEMENT_CACHE_CAPACITY=0.
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-secret-key-here

# db pool (all optional; defaults live in crates/db/src/pool.rs)
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_MIN_CONNECTIONS=0
# DATABASE_ACQUIRE_TIMEOUT_SECS=30
# DATABASE_IDLE_TIMEOUT_SECS=180
# DATABASE_MAX_LIFETIME_SECS=1800
# DATABASE_STATEMENT_CACHE_CAPACITY=100

# Stripe
STRIPE_API_URL="https://api.stripe.com/v1"
STRIPE_SECRET_KEY=""

# Resend
RESEND_API_KEY=""
