    "publish": "changeset publish",
    "test": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "yjs": "^13.6.26"
  },
  "devDependencies": {
    "@shallabuf-sdk/typescript": "workspace:*",
