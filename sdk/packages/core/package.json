    "typescript": "^5.0.0",
    "vitest": "^3.1.2"
  },
  "packageManager": "bun@1.2.12",
  "keywords": [
    "shallabuf",
    "sdk",
    "core",
    "beta",
    "unstable",
    "pre-release"
  ],
  "publishConfig": {
    "tag": "beta",
    "access": "public"
  }
