{
  "name": "@shallabuf-sdk/react",
  "license": "Apache-2.0",
  "version": "0.0.1-beta.17",
  "type": "module",
  "private": false,
  "description": "⚠️ BETA VERSION - APIs are subject to change without notice. Use with caution.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --out-dir dist"
  },
  "dependencies": {
    "@shallabuf-sdk/core": "0.0.1-beta.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@shallabuf-sdk/typescript": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "bun@1.2.11",
  "keywords": [
    "shallabuf",
    "sdk",
    "react",
    "beta",
    "unstable",
    "pre-release"
  ],
  "publishConfig": {
    "tag": "beta",
    "access": "public"
  }
}
