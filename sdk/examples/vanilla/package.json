{
  "name": "@shallabuf-sdk/vanilla-example",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "private": true,
  "description": "A simple web app using HTML, CSS, and TypeScript",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --env PUBLIC_* && cp index.html styles.css dist/",
    "dev": "bun --watch run src/server.ts",
    "start": "bun run src/server.ts"
  },
  "dependencies": {
    "@shallabuf-sdk/core": "workspace:*",
    "@types/bun": "^1.2.10",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "http-server": "^14.1.1",
    "ts-node-dev": "^2.0.0",
    "bun-types": "latest"
  }
}
