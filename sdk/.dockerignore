# flyctl launch added from platform/.gitignore
platform/target

# flyctl launch added from sdk/.gitignore
# Based on https://raw.githubusercontent.com/github/gitignore/main/Node.gitignore

# Logs

sdk/**/logs
sdk/**/_.log
sdk/**/npm-debug.log_
sdk/**/yarn-debug.log*
sdk/**/yarn-error.log*
sdk/**/lerna-debug.log*
sdk/**/.pnpm-debug.log*

# Caches

sdk/**/.cache

# Diagnostic reports (https://nodejs.org/api/report.html)

sdk/**/report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# Runtime data

sdk/**/pids
sdk/**/_.pid
sdk/**/_.seed
sdk/**/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover

sdk/**/lib-cov

# Coverage directory used by tools like istanbul

sdk/**/coverage
sdk/**/*.lcov

# nyc test coverage

sdk/**/.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)

sdk/**/.grunt

# Bower dependency directory (https://bower.io/)

sdk/**/bower_components

# node-waf configuration

sdk/**/.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)

sdk/**/build/Release

# Dependency directories

sdk/**/node_modules
sdk/**/jspm_packages

# Snowpack dependency directory (https://snowpack.dev/)

sdk/**/web_modules

# TypeScript cache

sdk/**/*.tsbuildinfo

# Optional npm cache directory

sdk/**/.npm

# Optional eslint cache

sdk/**/.eslintcache

# Optional stylelint cache

sdk/**/.stylelintcache

# Microbundle cache

sdk/**/.rpt2_cache
sdk/**/.rts2_cache_cjs
sdk/**/.rts2_cache_es
sdk/**/.rts2_cache_umd

# Optional REPL history

sdk/**/.node_repl_history

# Output of 'npm pack'

sdk/**/*.tgz

# Yarn Integrity file

sdk/**/.yarn-integrity

# dotenv environment variable files

sdk/**/.env
sdk/**/.env.development.local
sdk/**/.env.test.local
sdk/**/.env.production.local
sdk/**/.env.local

# parcel-bundler cache (https://parceljs.org/)

sdk/**/.parcel-cache

# Next.js build output

sdk/**/.next
sdk/**/out

# Nuxt.js build / generate output

sdk/**/.nuxt
sdk/**/dist

# Gatsby files

# Comment in the public line in if your project uses Gatsby and not Next.js

# https://nextjs.org/blog/next-9-1#public-directory-support

# public

# vuepress build output

sdk/**/.vuepress/dist

# vuepress v2.x temp and cache directory

sdk/**/.temp

# Docusaurus cache and generated files

sdk/**/.docusaurus

# Serverless directories

sdk/**/.serverless

# FuseBox cache

sdk/**/.fusebox

# DynamoDB Local files

sdk/**/.dynamodb

# TernJS port file

sdk/**/.tern-port

# Stores VSCode versions used for testing VSCode extensions

sdk/**/.vscode-test

# yarn v2

sdk/**/.yarn/cache
sdk/**/.yarn/unplugged
sdk/**/.yarn/build-state.yml
sdk/**/.yarn/install-state.gz
sdk/**/.pnp.*

# IntelliJ based IDEs
sdk/**/.idea

# Finder (MacOS) folder config
sdk/**/.DS_Store

# flyctl launch added from sdk/examples/nextjs/.gitignore
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
sdk/examples/nextjs/node_modules
sdk/examples/nextjs/.pnp
sdk/examples/nextjs/**/.pnp.*
sdk/examples/nextjs/**/.yarn/*
!sdk/examples/nextjs/**/.yarn/patches
!sdk/examples/nextjs/**/.yarn/plugins
!sdk/examples/nextjs/**/.yarn/releases
!sdk/examples/nextjs/**/.yarn/versions

# testing
sdk/examples/nextjs/coverage

# next.js
sdk/examples/nextjs/.next
sdk/examples/nextjs/out

# production
sdk/examples/nextjs/build

# misc
sdk/examples/nextjs/**/.DS_Store
sdk/examples/nextjs/**/*.pem

# debug
sdk/examples/nextjs/**/npm-debug.log*
sdk/examples/nextjs/**/yarn-debug.log*
sdk/examples/nextjs/**/yarn-error.log*
sdk/examples/nextjs/**/.pnpm-debug.log*

# env files (can opt-in for committing if needed)
sdk/examples/nextjs/**/.env*

# vercel
sdk/examples/nextjs/**/.vercel

# typescript
sdk/examples/nextjs/**/*.tsbuildinfo
sdk/examples/nextjs/**/next-env.d.ts
fly.toml
